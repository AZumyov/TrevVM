Screen {
    layout: vertical;
}

#intro {
    height: auto;
    max-height: 7;
    margin: 1 2 0 2;
    overflow: hidden;
}

#groups {
    height: 1fr;
    min-height: 6;
    margin: 0 1;
}

.group {
    width: 1fr;
    height: 1fr;
    margin: 0 1;
    padding: 0 1;
}

.group-title {
    text-style: bold;
}

.group SelectionList {
    height: 1fr;
    min-height: 4;
    border: none;
    padding: 0;
    background: transparent;
}

#settings {
    dock: bottom;
    height: auto;
    margin: 0 3;
}

.setting {
    width: 1fr;
    height: auto;
    margin-right: 2;
}

#kvm-hint {
    color: $text-muted;
}

#actions {
    dock: bottom;
    height: auto;
    align-horizontal: center;
    margin: 0;
}

#actions Button {
    margin: 0 1;
    min-width: 14;
}

Footer {
    height: auto;
}

ConfirmScreen {
    align: center middle;
}

#dialog {
    width: 74;
    max-width: 90%;
    height: auto;
    border: thick $accent;
    background: $surface;
    padding: 1 2;
}

#dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

#dialog-body {
    margin-bottom: 1;
}

#dialog-actions {
    height: auto;
    align-horizontal: right;
}

#dialog-actions Button {
    margin-left: 1;
}
